+/**
+ * @brief Interrupts any current and future blocking wait on the @a socket
+ * (see p_socket_io_condition_wait()) from another thread.
+ * @param socket #PSocket to wake up.
+ * @since 0.0.5-captions
+ * @note On Windows the socket waits on a WSA event which a local shutdown()
+ * does not signal; this sets a second, sticky per-socket event so the wait
+ * returns at once with #P_ERROR_IO_ABORTED. On other systems it is a no-op
+ * and a plain shutdown() on the descriptor wakes the poll()-based wait. It
+ * touches no socket state and can be called concurrently with any other
+ * #PSocket operation on a live socket; call it before, not after,
+ * p_socket_free().
+ */
+P_LIB_API void			p_socket_wakeup			(const PSocket		*socket);
+
